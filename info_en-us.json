    "equipment": {
        "introduction": {
            "list": [
                {
                    "description": "A U-tube oscillating density meter (DMA 1001, Anton Paar, Austria, repeatability standard deviation ±0.00005 gcm³) measures the density of a solution. This instrument can measure temperatures from 288.15 to 333.15 K and has a temperature control unit that maintains the temperature error of the U-tube within ±0.02 K. The components consist of a U-tube, an electromagnet, and a sensor. When liquid is introduced into the U-tube, the electromagnet generates an electrostatic force, causing the U-tube to oscillate up and down. The density meter calculates the density of the unknown substance by converting the oscillation frequency between the known oscillation frequency (water or air) and the unknown oscillation frequency.",
                    "image": "/assets/equipments/e1a150350c1a64ac413f4e99d246d491.png",
                    "title": "U-tube oscillating densitometer"
                },
                {
                    "description": "This laboratory uses a rotating packed bed for the chemical absorption of carbon dioxide, exploring the changes in mass transfer driving force and resistance under a hypergravity field, and calculating parameters such as the effective gas-liquid contact area and mass transfer coefficient to design for use in chemical processes in order to achieve net-zero carbon emissions.",
                    "image": "/assets/equipments/095178e81c0b4929c36b38674dd05852.png",
                    "title": "Rotating packed bed"
                }
            ],
            "title": "Equipment Introduction"
        },
