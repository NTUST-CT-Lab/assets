        "introduction": {
            "content": "Our laboratory focuses on the development of core technologies in the energy and chemical engineering fields. Our research includes carbon dioxide capture, thermophysical property measurement, model building, phase equilibrium measurement and simulation, and process intensification techniques. We combine theoretical research with experimental measurements to develop operational methods and modeling tools applicable to industrial processes. Our laboratory also maintains close collaboration with industry, jointly developing and exchanging technologies to promote the implementation of low-carbon industries, sustainable processes, and advanced chemical technologies.",
            "title": "About us"
        },
        "research": {
            "list": [
                {
                    "description": "Developing high-performance carbon dioxide adsorption materials and advanced capture technologies to reduce greenhouse gas emissions and address climate change challenges.",
                    "icon": "eco",
                    "icon_color": "rgba(40, 167, 69, 0.8)",
                    "tags": [
                        "Carbon Capture",
                        "Greenhouse Gases",
                        "Sustainable Development"
                    ],
                    "title": "Carbon Dioxide Capture"
                },
                {
                    "description": "Accurately measuring the thermophysical properties of chemical substances and developing predictive models to provide key parameters for chemical engineering design and simulation.",
                    "icon": "whatshot",
                    "icon_color": "rgba(220, 53, 69, 0.8)",
                    "tags": [
                        "Thermodynamics",
                        "Model Prediction",
                        "Property Database"
                    ],
                    "title": "Thermophysical Property Measurement and Model Development"
                },
                {
                    "description": "Studying the phase behavior of mixture systems through precise measurement and theoretical simulation to optimize separation processes and process design.",
                    "icon": "balance",
                    "icon_color": "rgba(0, 123, 255, 0.8)",
                    "tags": [
                        "Phase Equilibrium",
                        "Thermodynamic Models",
